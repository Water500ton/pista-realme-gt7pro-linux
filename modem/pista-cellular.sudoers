# Allow desktop admin users (pista, sudo on Debian/Ubuntu, wheel on Fedora) to
# toggle 5G/4G cellular without password prompts on touch screen.
pista ALL=(root) NOPASSWD: /usr/bin/systemctl start pista-cellular.service, /usr/bin/systemctl stop pista-cellular.service, /usr/bin/systemctl restart pista-cellular.service, /usr/local/bin/pista-cellular --write-config *, /usr/local/bin/pista-cellular --ping-test *
%sudo ALL=(root) NOPASSWD: /usr/bin/systemctl start pista-cellular.service, /usr/bin/systemctl stop pista-cellular.service, /usr/bin/systemctl restart pista-cellular.service, /usr/local/bin/pista-cellular --write-config *, /usr/local/bin/pista-cellular --ping-test *
%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl start pista-cellular.service, /usr/bin/systemctl stop pista-cellular.service, /usr/bin/systemctl restart pista-cellular.service, /usr/local/bin/pista-cellular --write-config *, /usr/local/bin/pista-cellular --ping-test *
