def find_vcm_subdev(vcm_name: str):
    if not vcm_name:
        return None
    for path in sorted(glob.glob("/sys/class/video4linux/v4l-subdev*/name")):
        try:
            with open(path, "r", encoding="utf-8") as f:
                if f.read().strip() == vcm_name:
                    dev_name = os.path.basename(os.path.dirname(path))
                    return f"/dev/{dev_name}"
        except OSError:
            continue
    return None


def load_af_calibration():
    calib = json.loads(json.dumps(DEFAULT_AF_CALIB))
    if os.path.isfile(AF_CALIB_PATH):
        try:
            with open(AF_CALIB_PATH, "r", encoding="utf-8") as f:
                user_data = json.load(f)
            for key, vals in user_data.items():
                if key in calib and isinstance(vals, dict):
                    calib[key].update(vals)
        except Exception:
            pass
    return calib


def calibrate_eeprom_cli():
    """Read factory GT24P128G AF (0x0092..0x0097) & 17x13 LSC (0x00d0..0x0521) calibration (run as root)."""
    calib = load_af_calibration()
    isp_profs = photo_isp.load_isp_profiles()
    isp_overrides = {}
    for key, spec in [
        ("rear_main", ("ak7375 3-000c", 3, 500, 50, 10)),
        ("rear_tele", ("ak7375 4-002d", 4, 5300, 130, 65)),
    ]:
        vcm_name, bus, dist_inf, dist_mid, dist_macro = spec
        subdev = find_vcm_subdev(vcm_name)
        if not subdev:
            print(f"[{key}] VCM {vcm_name} not found, keeping default")
            continue
        fd = os.open(subdev, os.O_RDWR)
        try:
            time.sleep(0.04)
            r = subprocess.run(
                ["i2ctransfer", "-y", str(bus), "w2@0x50", "0x00", "0x92", "r6"],
                capture_output=True,
                text=True,
                check=True,
            )
            raw = [int(tok, 16) for tok in r.stdout.strip().split()]
            if len(raw) == 6:
                macro_12 = raw[0] | (raw[1] << 8)
                inf_12 = raw[2] | (raw[3] << 8)
                mid_12 = raw[4] | (raw[5] << 8)
                if 200 <= inf_12 < macro_12 <= 4095:
                    dac_inf = round(inf_12 / 4.0)
                    dac_macro = round(macro_12 / 4.0)
                    dac_mid = round(mid_12 / 4.0) if inf_12 < mid_12 < macro_12 else (dac_inf + dac_macro) // 2
                    dac_min = max(20, dac_inf - 45)
                    dac_max = min(1000, max(985 if key == "rear_tele" else 960, dac_macro + 45))
                    d_inf = 100.0 / dist_inf
                    d_mac = 100.0 / dist_macro
                    d_hyp = 100.0 / (150.0 if key == "rear_main" else 350.0)
                    slope = (dac_macro - dac_inf) / max(0.01, (d_mac - d_inf))
                    dac_hyp = int(round(dac_inf + slope * max(0.0, d_hyp - d_inf)))
                    calib[key].update({
                        "dac_inf": dac_inf,
                        "dac_mid": dac_mid,
                        "dac_macro": dac_macro,
                        "dac_min": dac_min,
                        "dac_max": dac_max,
                        "dac_hyperfocal": max(dac_min, min(dac_max, dac_hyp)),
                    })
                    print(f"[{key}] EEPROM AF OK: inf={dac_inf}, mid={dac_mid}, macro={dac_macro}, hyp={dac_hyp}")
            try:
                r_g, g_g, b_g = photo_isp.read_eeprom_lsc_17x13(bus, 0x50, 0x00D0)
                base_p = dict(isp_profs.get(key, {}))
                base_p.update({"lsc_w": 17, "lsc_h": 13, "lsc_r": r_g, "lsc_g": g_g, "lsc_b": b_g, "lsc_source": "eeprom"})
                isp_overrides[key] = base_p
                print(f"[{key}] EEPROM LSC 17x13 OK: TL=({r_g[0]},{g_g[0]},{b_g[0]}) BR=({r_g[220]},{g_g[220]},{b_g[220]})")
            except Exception as lsc_exc:
                print(f"[{key}] EEPROM LSC skipped (using golden profile): {lsc_exc}")
        except Exception as exc:
            print(f"[{key}] EEPROM read failed: {exc}")
        finally:
            os.close(fd)
    with open(AF_CALIB_PATH, "w", encoding="utf-8") as f:
        json.dump(calib, f, indent=2)
    os.chmod(AF_CALIB_PATH, 0o644)
    print(f"Saved AF calibration to {AF_CALIB_PATH}")
    if isp_overrides:
        with open(ISP_CALIB_PATH, "w", encoding="utf-8") as f:
            json.dump(isp_overrides, f, separators=(",", ":"))
        os.chmod(ISP_CALIB_PATH, 0o644)
        print(f"Saved per-unit EEPROM LSC to {ISP_CALIB_PATH}")


def dac_to_distance_str(dac: int, cal: dict) -> str:
    if not cal:
        return f"DAC {dac}"
    dac_inf = cal["dac_inf"]
    dac_macro = cal["dac_macro"]
    if dac <= dac_inf + 8:
        return "∞"
    d_inf = 100.0 / float(cal.get("dist_inf_cm", 500))
    d_mac = 100.0 / float(cal.get("dist_macro_cm", 10))
    frac = max(0.0, (dac - dac_inf) / max(1.0, float(dac_macro - dac_inf)))
    diopter = d_inf + frac * (d_mac - d_inf)
    if diopter <= 0.12:
        return "∞"
    dist_cm = 100.0 / diopter
    if dist_cm >= 100.0:
        return f"{dist_cm / 100.0:.1f}m"
    return f"{int(round(dist_cm))}cm"


class VcmController:
    """Direct ioctl wrapper around AK7377 / AK7316 V4L2 lens subdevice."""

    def __init__(self):
        self._lock = threading.Lock()
        self.fd = None
        self.dev_path = None
        self.cur_dac = 512

    def open(self, vcm_name: str, initial_dac: int = 512) -> bool:
        self.close()
        if not vcm_name:
            return False
        dev = find_vcm_subdev(vcm_name)
        if not dev:
            return False
        try:
            fd = os.open(dev, os.O_RDWR)
            with self._lock:
                self.fd = fd
                self.dev_path = dev
                self.cur_dac = int(initial_dac)
            self.set_focus(initial_dac)
            return True
        except OSError:
            return False

    def close(self):
        with self._lock:
            fd = self.fd
            self.fd = None
            self.dev_path = None
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass

    def is_open(self) -> bool:
        return self.fd is not None

    def set_focus(self, dac: int) -> bool:
        dac = max(0, min(1023, int(round(dac))))
        with self._lock:
            if self.fd is None:
                return False
            try:
                fcntl.ioctl(self.fd, VIDIOC_S_CTRL, struct.pack("Ii", V4L2_CID_FOCUS_ABSOLUTE, dac))
                self.cur_dac = dac
                return True
            except OSError:
                return False


class StockStyleAFEngine:
    """Qualcomm BAF-inspired multi-band CDAF + CAF engine with factory EEPROM calibration.

    Features:
      - Dual-band spatial focus value (2px Tenengrad + 1px Modified Laplacian SML)
      - Noise-floor coring + mean-luma^2 normalization (immune to AE shifts & ISO grain)
      - 3x3 center-weighted ROI matrix (suppresses background edges)
      - Smart bidirectional coarse sweep with early peak termination
      - Fine bracket search + 3-point parabolic sub-step peak interpolation
      - Continuous AF (CAF) scene-change monitor via ROI SAD + FV drop detection
    """

    STATE_IDLE = "IDLE"
    STATE_COARSE = "COARSE"
    STATE_FINE = "FINE"
    STATE_LOCKED = "LOCKED"
    STATE_MF = "MF"

    # 3x3 center-weighted Qualcomm BAF zone weights
    ZONE_WEIGHTS = (
        (0.50, 0.75, 0.50),
        (0.75, 1.50, 0.75),
        (0.50, 0.75, 0.50),
    )

    def __init__(self, vcm: VcmController, on_update_cb):
        self.vcm = vcm
        self.on_update_cb = on_update_cb
        self._lock = threading.Lock()

        self.cal = None
        self.caf_enabled = True
        self.state = self.STATE_IDLE
        self.roi_norm = (0.5, 0.5)  # (cx, cy) normalized in viewfinder coords
        self.roi_size = 0.24        # 24% of frame min dimension

        # Sweep state (pipelined FIFO: send 1 DAC per frame, pair with frame latency = 2)
        self.pipeline_latency = 2   # frames from VCM ioctl to rendered frame in gtksink
        self.wait_left = 0
        self.sweep_dacs = []
        self.send_idx = 0
        self.inflight_dacs = []     # FIFO queue of commanded DACs waiting to appear
        self.measured_dacs = []
        self.measured_fvs = []
        self.coarse_step = 85
        self.coarse_min_fv = 0.0
        self.coarse_peak_fv = 0.0
        self.fine_step = 24

        # Lock & CAF monitoring state
        self.locked_dac = 200
        self.locked_fv = 0.0
        self.last_fv = 0.0
        self.prev_patch = None
        self.fv_drop_count = 0
        self.motion_active = False
        self.stable_after_motion = 0
        self.last_lock_time = 0.0
        self.warmup_frames = 0

    def configure(self, cal: dict, caf_enabled: bool = True):
        with self._lock:
            self.cal = cal
            self.caf_enabled = caf_enabled
            self.roi_norm = (0.5, 0.5)
            self.prev_patch = None
            self.fv_drop_count = 0
            self.motion_active = False
            self.stable_after_motion = 0
            self.warmup_frames = 5  # let SoftISP AE stabilize on camera start
            if cal is None:
                self.state = self.STATE_IDLE
            elif caf_enabled:
                self.locked_dac = cal["dac_hyperfocal"]
                self.state = self.STATE_IDLE
            else:
                self.state = self.STATE_MF

    def set_manual(self, dac: int):
        with self._lock:
            self.caf_enabled = False
            self.state = self.STATE_MF
            self.locked_dac = int(dac)
        self.vcm.set_focus(dac)
        self._emit("mf", dac, 0.0)

    def set_caf_enabled(self, enabled: bool):
        with self._lock:
            self.caf_enabled = enabled
            if not enabled:
                self.state = self.STATE_MF
            elif self.cal is not None:
                self.roi_norm = (0.5, 0.5)
        if enabled and self.cal is not None:
            self.trigger_af(0.5, 0.5)
        else:
            self._emit("mf", self.vcm.cur_dac, self.last_fv)

    def trigger_af(self, cx: float = 0.5, cy: float = 0.5):
        with self._lock:
            if not self.cal or not self.vcm.is_open():
                return
            self.roi_norm = (
                max(0.14, min(0.86, float(cx))),
                max(0.14, min(0.86, float(cy))),
            )
            self.warmup_frames = 0
            self._start_coarse_locked()

    def _begin_pipeline_sweep_locked(self, pts: list, new_state: str):
        cur = self.vcm.cur_dac
        self.sweep_dacs = pts
        self.send_idx = 0
        self.inflight_dacs = []
        self.measured_dacs = []
        self.measured_fvs = []
        self.state = new_state

        # Command first DAC and prime latency pipeline (wait 1 extra frame on huge jump)
        first_dac = self.sweep_dacs[0]
        self.vcm.set_focus(first_dac)
        self.inflight_dacs.append(first_dac)
        self.send_idx = 1
        self.wait_left = self.pipeline_latency + (1 if abs(first_dac - cur) > 300 else 0)

    def _start_coarse_locked(self):
        c = self.cal
        d_min = c["dac_min"]
        d_max = c["dac_max"]
        span = d_max - d_min
        # 10 diopter-uniform coarse points (~85-95 DAC on IMX906, ~70 DAC on IMX882)
        n_steps = 10
        self.coarse_step = max(30, int(round(span / (n_steps - 1))))
        pts = [int(round(d_min + i * span / (n_steps - 1))) for i in range(n_steps)]

        # Bidirectional: start from whichever boundary is closer to current lens position
        if abs(self.vcm.cur_dac - d_max) < abs(self.vcm.cur_dac - d_min):
            pts.reverse()

        self.coarse_min_fv = float("inf")
        self.coarse_peak_fv = 0.0
        self.fv_drop_count = 0
        self.motion_active = False
        self.stable_after_motion = 0
        self.prev_patch = None

        self._begin_pipeline_sweep_locked(pts, self.STATE_COARSE)
        self._emit("scanning", pts[0], 0.0)

    def _start_fine_locked(self, center_dac: int):
        c = self.cal
        d_min = c["dac_min"]
        d_max = c["dac_max"]
        self.fine_step = max(10, int(round(self.coarse_step / 3.0)))
        # 5-point tight fine bracket centered on coarse peak: [-2, -1, 0, +1, +2] * fine_step
        pts = []
        for k in (-2, -1, 0, 1, 2):
            v = max(d_min, min(d_max, int(round(center_dac + k * self.fine_step))))
            if not pts or pts[-1] != v:
                pts.append(v)
        if abs(self.vcm.cur_dac - pts[-1]) < abs(self.vcm.cur_dac - pts[0]):
            pts.reverse()
        self._begin_pipeline_sweep_locked(pts, self.STATE_FINE)

    def _finish_lock_locked(self):
        fvs = self.measured_fvs
        dacs = self.measured_dacs
        if not fvs:
            self.state = self.STATE_LOCKED
            return

        best_i = int(np.argmax(fvs))
        best_fv = fvs[best_i]
        best_dac = dacs[best_i]
        # Compare against FULL-RANGE coarse baseline (not narrow fine-bracket minimum!)
        baseline_fv = min(self.coarse_min_fv, min(fvs))
        peak_overall = max(self.coarse_peak_fv, best_fv)

        # Low-contrast guard: only fall back to hyperfocal if full range had <12% contrast change
        if peak_overall < 15.0 or (baseline_fv > 0 and (peak_overall / max(baseline_fv, 1e-3)) < 1.12):
            best_dac = self.cal["dac_hyperfocal"]
            status = "fallback"
        else:
            # 3-point parabolic sub-step interpolation around fine peak
            if 0 < best_i < len(fvs) - 1:
                y0, y1, y2 = fvs[best_i - 1], fvs[best_i], fvs[best_i + 1]
                x0, x1, x2 = dacs[best_i - 1], dacs[best_i], dacs[best_i + 1]
                denom = (y0 - 2.0 * y1 + y2)
                if denom < -1e-6:
                    offset = 0.5 * (y0 - y2) / denom
                    offset = max(-0.48, min(0.48, offset))
                    step_dir = (x2 - x0) * 0.5
                    best_dac = int(round(x1 + offset * step_dir))
            best_dac = max(self.cal["dac_min"], min(self.cal["dac_max"], best_dac))
            status = "locked"

        self.vcm.set_focus(best_dac)
        self.locked_dac = best_dac
        self.locked_fv = best_fv
        self.last_lock_time = time.monotonic()
        self.state = self.STATE_LOCKED
        self.wait_left = self.pipeline_latency + 1
        self.prev_patch = None
        self.fv_drop_count = 0
        self.motion_active = False
        self.stable_after_motion = 0
        self._emit(status, best_dac, best_fv)

    def _compute_baf_metric(self, arr_rgbx: np.ndarray):
        """Compute Qualcomm BAF-style dual-band center-weighted normalized FV + downsampled patch."""
        h, w, _ = arr_rgbx.shape
        cx, cy = self.roi_norm
        half_w = max(32, int(w * self.roi_size * 0.5))
        half_h = max(32, int(h * self.roi_size * 0.5))
        x0 = max(0, min(w - 2 * half_w, int(cx * w) - half_w))
        y0 = max(0, min(h - 2 * half_h, int(cy * h) - half_h))
        x1 = min(w, x0 + 2 * half_w)
        y1 = min(h, y0 + 2 * half_h)

        # Green channel (index 1 for both RGBx and BGRx), subsampled 2x for <1ms CPU time
        g = arr_rgbx[y0:y1:2, x0:x1:2, 1].astype(np.float32)
        rh, rw = g.shape
        if rh < 12 or rw < 12:
            return 0.0, None

        mean_g = float(g.mean()) + 2.0
        # Adaptive noise-floor coring (rejects high-ISO sensor grain)
        thr = max(3.0, 0.022 * mean_g)

        # Coarse band (2-pixel gradient Tenengrad)
        gx = np.maximum(0.0, np.abs(g[1:-1, 2:] - g[1:-1, :-2]) - thr)
        gy = np.maximum(0.0, np.abs(g[2:, 1:-1] - g[:-2, 1:-1]) - thr)
        # Fine band (1-pixel Modified Laplacian SML)
        lx = np.abs(2.0 * g[1:-1, 1:-1] - g[1:-1, :-2] - g[1:-1, 2:])
        ly = np.abs(2.0 * g[1:-1, 1:-1] - g[:-2, 1:-1] - g[2:, 1:-1])
        sml = np.maximum(0.0, lx + ly - thr)

        energy = (gx * gx) + (gy * gy) + 2.0 * (sml * sml)

        # 3x3 center-weighted zone sum
        eh, ew = energy.shape
        ys = (0, eh // 3, (2 * eh) // 3, eh)
        xs = (0, ew // 3, (2 * ew) // 3, ew)
        wsum = 0.0
        wtot = 0.0
        for r in range(3):
            for c in range(3):
                wt = self.ZONE_WEIGHTS[r][c]
                zone = energy[ys[r]:ys[r + 1], xs[c]:xs[c + 1]]
                if zone.size:
                    wsum += wt * float(zone.mean())
                    wtot += wt

        fv = (wsum / max(wtot, 1.0)) / (mean_g * mean_g + 16.0) * 1e5

        # Tiny 16x16 luma patch for CAF scene-change SAD detector
        sy = max(1, rh // 16)
        sx = max(1, rw // 16)
        patch = g[::sy, ::sx] / mean_g
        return fv, patch

    def process_frame(self, arr_rgbx: np.ndarray):
        with self._lock:
            if not self.cal or not self.vcm.is_open():
                return
            if self.state == self.STATE_MF:
                return

            if self.warmup_frames > 0:
                self.warmup_frames -= 1
                if self.warmup_frames == 0 and self.caf_enabled and self.state == self.STATE_IDLE:
                    self._start_coarse_locked()
                return

            if self.wait_left > 0:
                self.wait_left -= 1
                # While priming the latency FIFO (excluding any extra jump-settle frame), feed next DAC
                if (
                    self.state in (self.STATE_COARSE, self.STATE_FINE)
                    and self.wait_left < self.pipeline_latency
                    and self.send_idx < len(self.sweep_dacs)
                ):
                    nxt = self.sweep_dacs[self.send_idx]
                    self.vcm.set_focus(nxt)
                    self.inflight_dacs.append(nxt)
                    self.send_idx += 1
                return

            fv, patch = self._compute_baf_metric(arr_rgbx)
            self.last_fv = fv

            if self.state == self.STATE_COARSE:
                if self.inflight_dacs:
                    measured_dac = self.inflight_dacs.pop(0)
                    self.measured_dacs.append(measured_dac)
                    self.measured_fvs.append(fv)
                    if fv < self.coarse_min_fv:
                        self.coarse_min_fv = fv
                    if fv > self.coarse_peak_fv:
                        self.coarse_peak_fv = fv

                # Early peak termination once we clearly pass a strong optical peak
                early_stop = False
                if len(self.measured_fvs) >= 4:
                    pk_i = int(np.argmax(self.measured_fvs))
                    pk_v = self.measured_fvs[pk_i]
                    mn_v = min(self.measured_fvs[:pk_i + 1])
                    if (
                        pk_i <= len(self.measured_fvs) - 3
                        and pk_v > max(35.0, mn_v * 1.35)
                        and self.measured_fvs[-1] < pk_v * 0.72
                        and self.measured_fvs[-2] < pk_v * 0.85
                    ):
                        early_stop = True

                if early_stop or (self.send_idx >= len(self.sweep_dacs) and not self.inflight_dacs):
                    pk_i = int(np.argmax(self.measured_fvs))
                    pk_dac = self.measured_dacs[pk_i]
                    self._start_fine_locked(pk_dac)
                elif self.send_idx < len(self.sweep_dacs):
                    nxt = self.sweep_dacs[self.send_idx]
                    self.vcm.set_focus(nxt)
                    self.inflight_dacs.append(nxt)
                    self.send_idx += 1

            elif self.state == self.STATE_FINE:
                if self.inflight_dacs:
                    measured_dac = self.inflight_dacs.pop(0)
                    self.measured_dacs.append(measured_dac)
                    self.measured_fvs.append(fv)

                if self.send_idx >= len(self.sweep_dacs) and not self.inflight_dacs:
                    self._finish_lock_locked()
                elif self.send_idx < len(self.sweep_dacs):
                    nxt = self.sweep_dacs[self.send_idx]
                    self.vcm.set_focus(nxt)
                    self.inflight_dacs.append(nxt)
                    self.send_idx += 1

            elif self.state == self.STATE_LOCKED and self.caf_enabled:
                now = time.monotonic()
                # Refresh baseline FV right after settling at final locked DAC
                if self.prev_patch is None:
                    self.prev_patch = patch
                    if fv > self.locked_fv * 0.6:
                        self.locked_fv = max(self.locked_fv, fv)
                    return

                # 1.6s anti-hunting cooldown after lock
                if now - self.last_lock_time < 1.6:
                    self.prev_patch = patch
                    return

                sad = 0.0
                if patch is not None and patch.shape == self.prev_patch.shape:
                    sad = float(np.mean(np.abs(patch - self.prev_patch)))
                self.prev_patch = patch

                # Detect camera panning / new subject entering frame -> wait until still -> refocus
                if sad > 0.075:
                    self.motion_active = True
                    self.stable_after_motion = 0
                    self.fv_drop_count = 0
                    return

                if self.motion_active:
                    self.stable_after_motion += 1
                    if self.stable_after_motion >= 5:
                        self.motion_active = False
                        self.stable_after_motion = 0
                        self._start_coarse_locked()
                    return

                # Detect sustained defocus (e.g. subject moved closer/farther while phone is still)
                if self.locked_fv > 30.0 and fv < self.locked_fv * 0.74:
                    self.fv_drop_count += 1
                    if self.fv_drop_count >= 6:
                        self._start_coarse_locked()
                else:
                    self.fv_drop_count = 0

    def _emit(self, status: str, dac: int, fv: float):
        if self.on_update_cb:
            GLib.idle_add(self.on_update_cb, status, int(dac), float(fv), self.roi_norm)


