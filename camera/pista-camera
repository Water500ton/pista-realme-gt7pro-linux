    def on_toggle_af_mode(self, _btn):
        if not self.vcm.is_open():
            return
        new_caf = not self.af_engine.caf_enabled
        self._set_af_button_state(new_caf)
        self.af_engine.set_caf_enabled(new_caf)

    def on_refocus_clicked(self, _btn):
        if not self.vcm.is_open():
            return
        self._set_af_button_state(True)
        self.af_engine.caf_enabled = True
        self.af_engine.trigger_af(0.5, 0.5)

    def on_focus_slider_changed(self, scale):
        if self._slider_updating or not self.vcm.is_open():
            return
        dac = int(round(scale.get_value()))
        self._set_af_button_state(False)
        self.af_engine.set_manual(dac)

    def update_header(self):
        c = self.current_cam()
        m_txt = "镜像开" if c["mirror"] else "镜像关"
        self.title_lbl.set_text(c["label"])
        self.rot_btn.set_label(f"↻ {c['rot_deg']}°")
        self.mirror_btn.set_label(f"⇄ {m_txt}")
        other = CAMERAS[(self.cam_idx + 1) % len(CAMERAS)]
        self.switch_btn.set_label(f"切{other['short']}")
        for idx, btn in enumerate(self.lens_btns):
            ctx = btn.get_style_context()
            if idx == self.cam_idx:
                ctx.add_class("lens-btn-active")
            else:
                ctx.remove_class("lens-btn-active")

    def _update_mode_buttons(self):
        for mkey, btn in self.mode_btns.items():
            ctx = btn.get_style_context()
            if mkey == self.photo_mode:
                ctx.add_class("mode-btn-active")
            else:
                ctx.remove_class("mode-btn-active")

    def on_select_photo_mode(self, _btn, mode_key):
        self.photo_mode = mode_key
        self._update_mode_buttons()
        names = {"std": "标准 3帧超清 (MFNR+LSC+LTM)", "night": "夜景 6帧降噪 (MFNR+彩噪抑制)", "hdr": "HDR 3帧包围曝光融合", "raw": "单帧直出"}
        self.status_lbl.set_text(f"拍照模式: {names.get(mode_key, mode_key)}")

    def _on_sink_buffer(self, pad, info):
        """GStreamer pad probe on gtksink sink pad: feeds live frames to AF engine and burst/HDR collector."""
        buf = info.get_buffer()
        caps = pad.get_current_caps()
        if buf is None or caps is None:
            return Gst.PadProbeReturn.OK
        s = caps.get_structure(0)
        w = s.get_value("width")
        h = s.get_value("height")
        fmt = s.get_value("format")
        self.frame_w = w
        self.frame_h = h

        need_burst = False
        with self._burst_lock:
            need_burst = self._burst_active

        out_buf = None
        ok, mi = buf.map(Gst.MapFlags.READ)
        if ok:
            out_mi = None
            try:
                bpp = len(mi.data) // max(1, w * h)
                if bpp >= 3 and len(mi.data) >= w * h * bpp:
                    arr = np.frombuffer(mi.data, dtype=np.uint8, count=w * h * bpp).reshape((h, w, bpp))
                    if not need_burst:
                        self.awb_guard.analyze_frame(arr, fmt)

                    active_arr = arr
                    if self.awb_guard.is_active():
                        cand_buf = Gst.Buffer.new_allocate(None, len(mi.data), None)
                        cand_buf.pts = buf.pts
                        cand_buf.dts = buf.dts
                        cand_buf.duration = buf.duration
                        cand_buf.offset = buf.offset
                        ok2, cand_mi = cand_buf.map(Gst.MapFlags.WRITE)
                        if ok2:
                            out_buf = cand_buf
                            out_mi = cand_mi
                            out_arr = np.frombuffer(out_mi.data, dtype=np.uint8, count=w * h * bpp).reshape((h, w, bpp))
                            self.awb_guard.apply_to_arrays(arr, out_arr, fmt)
                            active_arr = out_arr

                    if need_burst:
                        self._handle_burst_frame(active_arr, fmt)
                    else:
                        self.ae_ctrl.process_frame(active_arr, fmt)
                        if self.vcm.is_open():
                            self.af_engine.process_frame(active_arr)
            finally:
                if out_buf is not None and out_mi is not None:
                    out_buf.unmap(out_mi)
                buf.unmap(mi)
        if out_buf is not None:
            info.set_buffer(out_buf)
        return Gst.PadProbeReturn.OK

    def _extract_rgb_copy(self, arr: np.ndarray, fmt: str) -> np.ndarray:
        if fmt in ("BGRx", "BGRA", "BGR"):
            return arr[:, :, [2, 1, 0]].copy()
        return arr[:, :, :3].copy()

    def _handle_burst_frame(self, arr: np.ndarray, fmt: str):
        done_payload = None
        with self._burst_lock:
            if not self._burst_active:
                return
            if self._burst_mode == "hdr":
                if self._hdr_wait > 0:
                    self._hdr_wait -= 1
                    # Re-apply current target bracket each wait frame so libcamera Agc cannot overwrite it
                    cur_idx = len(self._burst_frames)
                    if self.sensor_ctrl and cur_idx < len(self._hdr_brackets):
                        exp_v, gain_v = self._hdr_brackets[cur_idx]
                        self.sensor_ctrl.set_exposure_and_gain(exp_v, gain_v)
                    return
                self._burst_frames.append(self._extract_rgb_copy(arr, fmt))
                idx = len(self._burst_frames)
                if idx < len(self._hdr_brackets):
                    if self.sensor_ctrl:
                        exp_v, gain_v = self._hdr_brackets[idx]
                        self.sensor_ctrl.set_exposure_and_gain(exp_v, gain_v)
                    self._hdr_wait = 3  # wait 3 frames (2-frame pipeline delay + 1 margin)
                    GLib.idle_add(self.status_lbl.set_text, f"HDR 包围曝光采集中 ({idx}/{len(self._hdr_brackets)})...")
                    return
                # Restore original sensor exposure + analog gain and sync SmartAE
                if self.sensor_ctrl and self._hdr_orig_exp is not None:
                    og = getattr(self, "_hdr_orig_gain", None)
                    self.sensor_ctrl.set_exposure_and_gain(self._hdr_orig_exp, og)
                    self.ae_ctrl.cur_exp = self._hdr_orig_exp
                    if og is not None:
                        self.ae_ctrl.cur_gain = og
                    self.ae_ctrl.wait_frames = 3
                self._burst_active = False
                done_payload = (list(self._burst_frames), self._burst_mode)
            else:
                # Hold SmartAE exposure steady across MFNR burst frames
                if self.sensor_ctrl and self.ae_ctrl.cur_exp is not None:
                    self.sensor_ctrl.set_exposure_and_gain(self.ae_ctrl.cur_exp, self.ae_ctrl.cur_gain)
                self._burst_frames.append(self._extract_rgb_copy(arr, fmt))
                idx = len(self._burst_frames)
                if idx < self._burst_target:
                    GLib.idle_add(self.status_lbl.set_text, f"多帧连拍中 ({idx}/{self._burst_target})...")
                    return
                self._burst_active = False
                done_payload = (list(self._burst_frames), self._burst_mode)

        if done_payload is not None:
            frames, mode = done_payload
            self._launch_develop_thread(frames, mode)

    def stop_camera(self):
        with self._burst_lock:
            self._burst_active = False
            self._burst_frames = []
        self.reticle_state = None
        if self.pipeline is not None:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        self.sink = None
        self.flip = None
        self.sensor_ctrl = None
        self.vcm.close()
        for child in self.vf_box.get_children():
            self.vf_box.remove(child)

    def start_camera(self):
        self.stop_camera()
        c = self.current_cam()
        cal = self.current_cal()
        self.sensor_ctrl = photo_isp.SensorControlHelper(c.get("sensor_prefix", ""))
        self.ae_ctrl.configure(c["key"], self.sensor_ctrl)
        self.awb_guard.reset()
        self.update_header()

        # Open VCM lens actuator if supported on this camera
        has_vcm = False
        if c.get("vcm_name") and cal:
            has_vcm = self.vcm.open(c["vcm_name"], cal["dac_hyperfocal"])
        if has_vcm:
            self._slider_updating = True
            self.focus_scale.set_range(cal["dac_min"], cal["dac_max"])
            self.focus_scale.set_value(cal["dac_hyperfocal"])
            self._slider_updating = False
            self.dist_lbl.set_text(dac_to_distance_str(cal["dac_hyperfocal"], cal))
            self._set_af_button_state(True)
            self.af_engine.configure(cal, caf_enabled=True)
            self.focusbar.show_all()
        else:
            self.af_engine.configure(None, caf_enabled=False)
            self.focusbar.hide()

        method = self.current_flip_method()
        desc = (
            f'libcamerasrc camera-name="{c["path"]}" ! '
            f'video/x-raw,width={c["width"]},height={c["height"]} ! '
            f'videoflip name=flip method={method} ! '
            f'videoconvert ! '
            f'gtksink name=sink enable-last-sample=true sync=false'
        )
        try:
            self.pipeline = Gst.parse_launch(desc)
            self.sink = self.pipeline.get_by_name("sink")
            self.flip = self.pipeline.get_by_name("flip")

            # Attach pad probe on ALL cameras for AF + MFNR/HDR burst frame capture
            sink_pad = self.sink.get_static_pad("sink")
            if sink_pad:
                sink_pad.add_probe(Gst.PadProbeType.BUFFER, self._on_sink_buffer)

            widget = self.sink.get_property("widget")
            widget.set_hexpand(True)
            widget.set_vexpand(True)
            self.vf_box.pack_start(widget, True, True, 0)
            self.vf_box.show_all()

            bus = self.pipeline.get_bus()
            bus.add_signal_watch()
            bus.connect("message::error", self.on_gst_error)
            bus.connect("message::state-changed", self.on_gst_state)

            self.pipeline.set_state(Gst.State.PLAYING)
            self.status_lbl.set_text(f"正在启动 {c['short']} ({c['width']}×{c['height']})...")
        except Exception as exc:
            self.status_lbl.set_text(f"启动失败: {exc}")
        return False

    def on_gst_state(self, _bus, msg):
        if msg.src == self.pipeline:
            _old, new, _pending = msg.parse_state_changed()
            if new == Gst.State.PLAYING:
                c = self.current_cam()
                af_txt = " · 闭环自动对焦" if self.vcm.is_open() else " · 定焦"
                self.status_lbl.set_text(
                    f"实时预览 · {c['width']}×{c['height']}{af_txt}"
                )

    def on_gst_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self.status_lbl.set_text(f"流错误: {err.message}")

    def _set_flash_idx(self, idx: int):
        self.flash_idx = idx % len(self.flash_levels)
        val = self.flash_levels[self.flash_idx]
        labels = ["⚡ 关", "⚡ 柔光", "⚡ 强光"]
        try:
            with open("/sys/class/leds/white:flash/brightness", "w", encoding="utf-8") as f:
                f.write(str(val))
        except OSError:
            self.flash_idx = 0
            val = 0
        self.flash_btn.set_label(labels[self.flash_idx])
        ctx = self.flash_btn.get_style_context()
        if val > 0:
            ctx.add_class("af-btn-active")
        else:
            ctx.remove_class("af-btn-active")

    def on_toggle_flash(self, _btn):
        if self.current_cam()["key"] == "front":
            self._set_flash_idx(0)
            self.status_lbl.set_text("前置摄像头不支持后置闪光灯")
            return
        self._set_flash_idx(self.flash_idx + 1)

    def on_rotate(self, _btn):
        c = self.current_cam()
        c["rot_deg"] = (c["rot_deg"] + 90) % 360
        self.start_camera()

    def on_mirror(self, _btn):
        c = self.current_cam()
        c["mirror"] = not c["mirror"]
        self.start_camera()

    def on_select_camera(self, _btn, idx):
        if idx != self.cam_idx:
            self.cam_idx = idx
            if self.current_cam()["key"] == "front":
                self._set_flash_idx(0)
            self.start_camera()

    def on_switch_camera(self, _btn):
        self.cam_idx = (self.cam_idx + 1) % len(CAMERAS)
        if self.current_cam()["key"] == "front":
            self._set_flash_idx(0)
        self.start_camera()

    def on_capture(self, _btn):
        if self.sink is None:
            return
        with self._burst_lock:
            if self._burst_active or self._developing:
                self.status_lbl.set_text("正在合成上一张照片，请稍候...")
                return
            mode = self.photo_mode
            self._burst_mode = mode
            self._burst_frames = []
            if mode == "raw":
                self._burst_target = 1
                self._burst_active = True
                self.status_lbl.set_text("正在拍摄直出照片...")
            elif mode == "hdr":
                orig_exp = self.ae_ctrl.cur_exp if self.ae_ctrl.cur_exp is not None else (
                    self.sensor_ctrl.get_exposure() if self.sensor_ctrl else None
                )
                orig_gain = self.ae_ctrl.cur_gain if self.ae_ctrl.cur_gain is not None else (
                    self.sensor_ctrl.get_gain() if self.sensor_ctrl else None
                )
                if orig_exp and orig_exp >= 4:
                    skey = self.current_cam()["key"]
                    # Balanced -2.2 EV / 0 EV / +1.1 EV brackets: recovers bright screen text cleanly
                    # while keeping white windows bright instead of muddy gray
                    b_lo = self.sensor_ctrl.compute_ev_bracket(skey, orig_exp, orig_gain, 0.22)
                    b_mid = (orig_exp, orig_gain)
                    b_hi = self.sensor_ctrl.compute_ev_bracket(skey, orig_exp, orig_gain, 2.20)
                    self._hdr_orig_exp = orig_exp
                    self._hdr_orig_gain = orig_gain
                    self._hdr_brackets = [b_lo, b_mid, b_hi]
                    self.sensor_ctrl.set_exposure_and_gain(*b_lo)
                    self._hdr_wait = 3
                    self._burst_target = 3
                    self._burst_active = True
                    self.status_lbl.set_text("HDR 包围曝光采集中 (0/3)...")
                else:
                    # Fallback to 3-frame MFNR+LTM if exposure control unavailable
                    self._burst_mode = "std"
                    self._burst_target = 3
                    self._burst_active = True
                    self.status_lbl.set_text("多帧连拍中 (0/3)...")
            elif mode == "night":
                self._burst_target = 6
                self._burst_active = True
                self.status_lbl.set_text("夜景 6 帧连拍中，请握稳手机...")
            else:
                self._burst_target = 3
                self._burst_active = True
                self.status_lbl.set_text("标准 3 帧超清连拍中...")

    def _launch_develop_thread(self, frames: list, mode: str):
        c = dict(self.current_cam())
        cal = self.current_cal()
        prof = self.isp_profiles.get(c["key"])
        exp_sec, iso = (None, None)
        if self.sensor_ctrl:
            exp_sec, iso = self.sensor_ctrl.estimate_exif_params(c["key"])
        focus_m = None
        if cal and self.vcm.is_open():
            d_str = dac_to_distance_str(self.vcm.cur_dac, cal)
            if d_str.endswith("cm"):
                focus_m = float(d_str[:-2]) / 100.0
            elif d_str.endswith("m"):
                focus_m = float(d_str[:-1])

        with self._burst_lock:
            self._developing = True
        mode_lbl = {"std": "标准超清", "night": "夜景 MFNR", "hdr": "HDR 融合", "raw": "直出"}.get(mode, mode)
        GLib.idle_add(self.status_lbl.set_text, f"正在后台 ISP 合成 ({mode_lbl})...")

        def worker():
            try:
                img, exif_b, st = photo_isp.develop_photo(
                    frames,
                    mode=mode,
                    profile=prof,
                    rot_deg=c["rot_deg"],
                    mirror=bool(c["mirror"]),
                    exp_sec=exp_sec,
                    iso=iso,
                    focus_dist_m=focus_m,
                )
                ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                out_path = os.path.join(self.pictures_dir, f"IMG_{ts}_{c['key']}_{mode}.jpg")
                img.save(out_path, format="JPEG", quality=95, subsampling=0, exif=exif_b)
                w, h = img.size
                GLib.idle_add(
                    self._on_photo_saved,
                    os.path.basename(out_path),
                    w,
                    h,
                    mode_lbl,
                    st["ms"],
                )
            except Exception as exc:
                GLib.idle_add(self.status_lbl.set_text, f"ISP 合成失败: {exc}")
            finally:
                with self._burst_lock:
                    self._developing = False

        threading.Thread(target=worker, daemon=True).start()

    def _on_photo_saved(self, fname: str, w: int, h: int, mode_lbl: str, ms: float):
        self.photo_count += 1
        self.gallery_btn.set_label(f"相册 ({self.photo_count})")
        self.status_lbl.set_text(f"已保存 {mode_lbl}: {fname} ({w}×{h}, {ms:.0f}ms)")
        return False

    def on_open_gallery(self, _btn):
        subprocess.Popen(["xdg-open", self.pictures_dir])

    def on_destroy(self, _win):
        self._set_flash_idx(0)
        self.stop_camera()
        Gtk.main_quit()


