    def _compute_video_rect(self, alloc_w, alloc_h):
        """Return (ox, oy, rw, rh) of the aspect-fitted video inside the DrawingArea."""
        if alloc_w <= 0 or alloc_h <= 0 or self.frame_w <= 0 or self.frame_h <= 0:
            return 0.0, 0.0, float(alloc_w), float(alloc_h)
        scale = min(alloc_w / float(self.frame_w), alloc_h / float(self.frame_h))
        rw = self.frame_w * scale
        rh = self.frame_h * scale
        ox = (alloc_w - rw) * 0.5
        oy = (alloc_h - rh) * 0.5
        return ox, oy, rw, rh

    def on_draw_reticle(self, widget, cr):
        if not self.reticle_state:
            return False
        now = time.monotonic()
        if self.reticle_state != "scanning" and now > self.reticle_until:
            self.reticle_state = None
            return False

        alloc = widget.get_allocation()
        ox, oy, rw, rh = self._compute_video_rect(alloc.width, alloc.height)
        cx = ox + self.reticle_pos[0] * rw
        cy = oy + self.reticle_pos[1] * rh

        # Alpha fade in last 0.4s
        alpha = 1.0
        if self.reticle_state != "scanning":
            rem = self.reticle_until - now
            if rem < 0.4:
                alpha = max(0.0, rem / 0.4)

        if self.reticle_state == "scanning":
            pulse = 1.0 + 0.08 * math.sin(now * 16.0)
            size = 44.0 * pulse
            cr.set_source_rgba(1.0, 0.82, 0.15, 0.95)
        elif self.reticle_state == "locked":
            size = 38.0
            cr.set_source_rgba(0.18, 0.88, 0.45, alpha)
        else:
            size = 38.0
            cr.set_source_rgba(0.95, 0.45, 0.25, alpha)

        # Draw sleek corner brackets
        cr.set_line_width(2.6)
        b = 12.0
        x0, y0 = cx - size, cy - size
        x1, y1 = cx + size, cy + size
        for px, py, dx, dy in [
            (x0, y0, b, b),
            (x1, y0, -b, b),
            (x0, y1, b, -b),
            (x1, y1, -b, -b),
        ]:
            cr.move_to(px, py + dy)
            cr.line_to(px, py)
            cr.line_to(px + dx, py)
        cr.stroke()

        # Center dot
        cr.arc(cx, cy, 2.5, 0, 2 * math.pi)
        cr.fill()

        # Distance badge below reticle
        if self.reticle_label:
            cr.select_font_face("Sans", 0, 1)
            cr.set_font_size(13)
            ext = cr.text_extents(self.reticle_label)
            tx = cx - ext.width * 0.5
            ty = y1 + 18.0
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.65 * alpha)
            cr.rectangle(tx - 6, ty - ext.height - 4, ext.width + 12, ext.height + 8)
            cr.fill()
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.95 * alpha)
            cr.move_to(tx, ty)
            cr.show_text(self.reticle_label)
        return False

    def _tick_reticle_fade(self):
        if self.reticle_state is not None:
            self.reticle_area.queue_draw()
        return True

    def _trigger_tap_xy(self, widget, x: float, y: float):
        alloc = widget.get_allocation()
        ox, oy, rw, rh = self._compute_video_rect(alloc.width, alloc.height)
        if rw <= 0 or rh <= 0:
            return False
        nx = (x - ox) / rw
        ny = (y - oy) / rh
        if 0.0 <= nx <= 1.0 and 0.0 <= ny <= 1.0:
            # Always update AE metering ROI (Tap-to-Meter works on ALL 4 cameras!)
            self.ae_ctrl.set_metering_point(nx, ny)
            if self.vcm.is_open():
                # Switching back to AF if in MF when user taps viewfinder
                self._set_af_button_state(True)
                self.af_engine.caf_enabled = True
                self.af_engine.trigger_af(nx, ny)
            else:
                self.reticle_pos = (nx, ny)
                self.reticle_state = "locked"
                self.reticle_label = "已测光"
                self.reticle_until = time.monotonic() + 1.6
                self.reticle_area.queue_draw()
            return True
        return False

