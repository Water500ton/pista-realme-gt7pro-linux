From: Realme GT7 Pro Mainline Linux Port
Subject: [PATCH 12/12] media: i2c: ak7375: add AK7377 and AK7316 VCM actuator support

Add chip definitions and stock-matched initialization sequences for the
Asahi Kasei AK7377 (IMX906 main wide) and AK7316 (IMX882 3x periscope
telephoto) closed-loop Hall-effect VCM actuators used on Realme GT7 Pro
(SM8750 / pista).

Key additions:
- 10-bit position register mapping (0..1023, shift 6) with 512 center park
  position to prevent mechanical shock on open/close.
- Optional per-chip init register sequence (supporting AK7316 setting-mode
  unlock 0xae=0x3b, 0x09=0x00, lock 0xae=0x00, center pre-position, active).
- Smooth anti-shock stepping for large focus jumps (>128 DAC) while keeping
  single-write low-latency moves for autofocus sweeps.
- Proper regulator cleanup on resume I2C failure.

Signed-off-by: Water500ton <Water500ton@users.noreply.github.com>
---
diff --git a/drivers/media/i2c/ak7375.c b/drivers/media/i2c/ak7375.c
index 9a2432c..dc149d4 100644
--- a/drivers/media/i2c/ak7375.c
+++ b/drivers/media/i2c/ak7375.c
@@ -10,6 +10,12 @@
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 
+struct ak73xx_reg_seq {
+	u8 reg;
+	u8 val;
+	u16 delay_us;
+};
+
 struct ak73xx_chipdef {
 	u8 reg_position;
 	u8 reg_cont;
@@ -18,6 +24,8 @@ struct ak73xx_chipdef {
 	u8 mode_standby;
 	bool has_standby;	/* Some chips may not have standby mode */
 	u16 focus_pos_max;
+	u16 focus_pos_def;
+	u16 park_pos;
 	/*
 	 * This sets the minimum granularity for the focus positions.
 	 * A value of 1 gives maximum accuracy for a desired focus position
@@ -36,6 +44,28 @@ struct ak73xx_chipdef {
 	 * I2C messages.
 	 */
 	u16 power_delay_us;
+	/* Optional large-jump anti-shock stepping threshold (0 = direct write) */
+	u16 jump_step_max;
+	u16 jump_delay_us;
+	/* Optional chip-specific init sequence executed on resume */
+	const struct ak73xx_reg_seq *init_seq;
+	unsigned int init_seq_len;
+};
+
+static const struct ak73xx_reg_seq ak7377_init_seq[] = {
+	{ 0x02, 0x00, 1100 },	/* Active closed-loop mode */
+	{ 0x02, 0x00, 5000 },	/* Settle */
+};
+
+static const struct ak73xx_reg_seq ak7316_init_seq[] = {
+	{ 0x02, 0x40, 2800 },	/* Standby */
+	{ 0x02, 0x40, 2800 },	/* Standby settle */
+	{ 0xae, 0x3b,  100 },	/* Unlock setting mode */
+	{ 0x09, 0x00,  100 },	/* Configure closed-loop control */
+	{ 0xae, 0x00,   50 },	/* Lock setting mode */
+	{ 0x00, 0x80,   50 },	/* Initial mid position MSB (512) */
+	{ 0x01, 0x00,   50 },	/* Initial mid position LSB */
+	{ 0x02, 0x00, 2800 },	/* Active closed-loop mode */
 };
 
 static const struct ak73xx_chipdef ak7345_cdef = {
@@ -45,6 +75,8 @@ static const struct ak73xx_chipdef ak7345_cdef = {
 	.mode_active	= 0x0,
 	.has_standby	= false,
 	.focus_pos_max	= 511,
+	.focus_pos_def	= 0,
+	.park_pos	= 0,
 	.focus_steps	= 1,
 	.ctrl_steps	= 16,
 	.ctrl_delay_us	= 1000,
@@ -59,12 +91,54 @@ static const struct ak73xx_chipdef ak7375_cdef = {
 	.mode_standby	= 0x40,
 	.has_standby	= true,
 	.focus_pos_max	= 4095,
+	.focus_pos_def	= 0,
+	.park_pos	= 0,
 	.focus_steps	= 1,
 	.ctrl_steps	= 64,
 	.ctrl_delay_us	= 1000,
 	.power_delay_us	= 10000,
 };
 
+static const struct ak73xx_chipdef ak7377_cdef = {
+	.reg_position	= 0x0,
+	.reg_cont	= 0x2,
+	.shift_pos	= 6,	/* 10-bit position values (0..1023), << 6 */
+	.mode_active	= 0x0,
+	.mode_standby	= 0x40,
+	.has_standby	= true,
+	.focus_pos_max	= 1023,
+	.focus_pos_def	= 512,
+	.park_pos	= 512,
+	.focus_steps	= 1,
+	.ctrl_steps	= 32,
+	.ctrl_delay_us	= 1000,
+	.power_delay_us	= 10000,
+	.jump_step_max	= 128,
+	.jump_delay_us	= 2000,
+	.init_seq	= ak7377_init_seq,
+	.init_seq_len	= ARRAY_SIZE(ak7377_init_seq),
+};
+
+static const struct ak73xx_chipdef ak7316_cdef = {
+	.reg_position	= 0x0,
+	.reg_cont	= 0x2,
+	.shift_pos	= 6,	/* 10-bit position values (0..1023), << 6 */
+	.mode_active	= 0x0,
+	.mode_standby	= 0x40,
+	.has_standby	= true,
+	.focus_pos_max	= 1023,
+	.focus_pos_def	= 512,
+	.park_pos	= 512,
+	.focus_steps	= 1,
+	.ctrl_steps	= 32,
+	.ctrl_delay_us	= 1000,
+	.power_delay_us	= 5000,
+	.jump_step_max	= 128,
+	.jump_delay_us	= 2000,
+	.init_seq	= ak7316_init_seq,
+	.init_seq_len	= ARRAY_SIZE(ak7316_init_seq),
+};
+
 static const char * const ak7375_supply_names[] = {
 	"vdd",
 	"vio",
@@ -80,6 +154,7 @@ struct ak7375_device {
 
 	/* active or standby mode */
 	bool active;
+	int cur_pos;
 };
 
 static inline struct ak7375_device *to_ak7375_vcm(struct v4l2_ctrl *ctrl)
@@ -114,14 +189,55 @@ static int ak7375_i2c_write(struct ak7375_device *ak7375,
 	return 0;
 }
 
+static int ak7375_ramp_position(struct ak7375_device *ak7375,
+				int target, int step, u16 delay_us)
+{
+	const struct ak73xx_chipdef *cdef = ak7375->cdef;
+	struct device *dev = ak7375->sd.dev;
+	int pos = ak7375->cur_pos;
+	int ret = 0;
+
+	if (step <= 0 || abs(target - pos) <= step) {
+		ret = ak7375_i2c_write(ak7375, cdef->reg_position,
+				       target << cdef->shift_pos, 2);
+		if (!ret)
+			ak7375->cur_pos = target;
+		return ret;
+	}
+
+	while (pos != target) {
+		if (target > pos)
+			pos = min(pos + step, target);
+		else
+			pos = max(pos - step, target);
+
+		ret = ak7375_i2c_write(ak7375, cdef->reg_position,
+				       pos << cdef->shift_pos, 2);
+		if (ret) {
+			dev_err_ratelimited(dev, "%s I2C failure: %d\n",
+					    __func__, ret);
+			return ret;
+		}
+		ak7375->cur_pos = pos;
+		if (pos != target && delay_us)
+			usleep_range(delay_us, delay_us + 100);
+	}
+
+	return 0;
+}
+
 static int ak7375_set_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct ak7375_device *dev_vcm = to_ak7375_vcm(ctrl);
 	const struct ak73xx_chipdef *cdef = dev_vcm->cdef;
 
-	if (ctrl->id == V4L2_CID_FOCUS_ABSOLUTE)
-		return ak7375_i2c_write(dev_vcm, cdef->reg_position,
-					ctrl->val << cdef->shift_pos, 2);
+	if (ctrl->id == V4L2_CID_FOCUS_ABSOLUTE) {
+		if (!dev_vcm->active)
+			return 0;
+		return ak7375_ramp_position(dev_vcm, ctrl->val,
+					    cdef->jump_step_max,
+					    cdef->jump_delay_us);
+	}
 
 	return -EINVAL;
 }
@@ -165,7 +281,8 @@ static int ak7375_init_controls(struct ak7375_device *dev_vcm)
 	v4l2_ctrl_handler_init(hdl, 1);
 
 	dev_vcm->focus = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_FOCUS_ABSOLUTE,
-		0, cdef->focus_pos_max, cdef->focus_steps, 0);
+		0, cdef->focus_pos_max, cdef->focus_steps, cdef->focus_pos_def);
+	dev_vcm->cur_pos = cdef->park_pos;
 
 	if (hdl->error)
 		dev_err(dev_vcm->sd.dev, "%s fail error: 0x%x\n",
@@ -249,20 +366,13 @@ static int __maybe_unused ak7375_vcm_suspend(struct device *dev)
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct ak7375_device *ak7375_dev = sd_to_ak7375_vcm(sd);
 	const struct ak73xx_chipdef *cdef = ak7375_dev->cdef;
-	int ret, val;
+	int ret;
 
 	if (!ak7375_dev->active)
 		return 0;
 
-	for (val = ak7375_dev->focus->val & ~(cdef->ctrl_steps - 1);
-	     val >= 0; val -= cdef->ctrl_steps) {
-		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_position,
-				       val << cdef->shift_pos, 2);
-		if (ret)
-			dev_err_once(dev, "%s I2C failure: %d\n",
-				     __func__, ret);
-		usleep_range(cdef->ctrl_delay_us, cdef->ctrl_delay_us + 10);
-	}
+	ak7375_ramp_position(ak7375_dev, cdef->park_pos,
+			     cdef->ctrl_steps, cdef->ctrl_delay_us);
 
 	if (cdef->has_standby) {
 		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
@@ -292,7 +402,8 @@ static int __maybe_unused ak7375_vcm_resume(struct device *dev)
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct ak7375_device *ak7375_dev = sd_to_ak7375_vcm(sd);
 	const struct ak73xx_chipdef *cdef = ak7375_dev->cdef;
-	int ret, val;
+	unsigned int i;
+	int ret;
 
 	if (ak7375_dev->active)
 		return 0;
@@ -305,32 +416,48 @@ static int __maybe_unused ak7375_vcm_resume(struct device *dev)
 	/* Wait for vcm to become ready */
 	usleep_range(cdef->power_delay_us, cdef->power_delay_us + 500);
 
-	ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
-			       cdef->mode_active, 1);
-	if (ret) {
-		dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
-		return ret;
+	if (cdef->init_seq_len) {
+		for (i = 0; i < cdef->init_seq_len; i++) {
+			ret = ak7375_i2c_write(ak7375_dev,
+					       cdef->init_seq[i].reg,
+					       cdef->init_seq[i].val, 1);
+			if (ret) {
+				dev_err(dev, "%s init[%u] reg 0x%02x failed: %d\n",
+					__func__, i, cdef->init_seq[i].reg, ret);
+				goto err_disable;
+			}
+			if (cdef->init_seq[i].delay_us)
+				usleep_range(cdef->init_seq[i].delay_us,
+					     cdef->init_seq[i].delay_us + 100);
+		}
+	} else {
+		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
+				       cdef->mode_active, 1);
+		if (ret) {
+			dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+			goto err_disable;
+		}
 	}
 
-	for (val = ak7375_dev->focus->val % cdef->ctrl_steps;
-	     val <= ak7375_dev->focus->val;
-	     val += cdef->ctrl_steps) {
-		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_position,
-				       val << cdef->shift_pos, 2);
-		if (ret)
-			dev_err_ratelimited(dev, "%s I2C failure: %d\n",
-						__func__, ret);
-		usleep_range(cdef->ctrl_delay_us, cdef->ctrl_delay_us + 10);
-	}
+	ak7375_dev->cur_pos = cdef->park_pos;
+	ak7375_ramp_position(ak7375_dev, ak7375_dev->focus->val,
+			     cdef->ctrl_steps, cdef->ctrl_delay_us);
 
 	ak7375_dev->active = true;
 
 	return 0;
+
+err_disable:
+	regulator_bulk_disable(ARRAY_SIZE(ak7375_supply_names),
+			       ak7375_dev->supplies);
+	return ret;
 }
 
 static const struct of_device_id ak7375_of_table[] = {
 	{ .compatible = "asahi-kasei,ak7345", .data = &ak7345_cdef, },
 	{ .compatible = "asahi-kasei,ak7375", .data = &ak7375_cdef, },
+	{ .compatible = "asahi-kasei,ak7377", .data = &ak7377_cdef, },
+	{ .compatible = "asahi-kasei,ak7316", .data = &ak7316_cdef, },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, ak7375_of_table);
