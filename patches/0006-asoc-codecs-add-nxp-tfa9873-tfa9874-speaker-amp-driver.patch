+static void tfa9874_regulator_disable(void *data)
+{
+	regulator_disable(data);
+}
+
+static int tfa9874_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct tfa9874 *tfa;
+	unsigned int rev = 0, id;
+	u32 slot;
+	int ret;
+
+	tfa = devm_kzalloc(dev, sizeof(*tfa), GFP_KERNEL);
+	if (!tfa)
+		return -ENOMEM;
+
+	tfa->dev = dev;
+	tfa->gain = min_t(unsigned int, default_gain, TFA_GAIN_MAX);
+	tfa->enabled = true;
+	tfa->slot = (i2c->addr & 1) ? 1 : 0;
+	if (!of_property_read_u32(dev->of_node, "nxp,tdm-slot", &slot))
+		tfa->slot = slot & 0xf;
+
+	i2c_set_clientdata(i2c, tfa);
+
+	tfa->vdd = devm_regulator_get_optional(dev, "vdd");
+	if (IS_ERR(tfa->vdd)) {
+		if (PTR_ERR(tfa->vdd) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(tfa->vdd), "vdd supply\n");
+		tfa->vdd = NULL;
+	} else {
+		ret = regulator_enable(tfa->vdd);
+		if (ret)
+			return dev_err_probe(dev, ret, "enable vdd\n");
+		ret = devm_add_action_or_reset(dev, tfa9874_regulator_disable,
+					       tfa->vdd);
+		if (ret)
+			return ret;
+		usleep_range(2000, 3000);
+	}
+
+	/* Assert reset (logical 1), then release (logical 0) to run */
+	tfa->reset = devm_gpiod_get_optional(dev, "reset",
+					     invert_reset ? GPIOD_OUT_LOW : GPIOD_OUT_HIGH);
+	if (IS_ERR(tfa->reset))
+		return dev_err_probe(dev, PTR_ERR(tfa->reset), "reset gpio\n");
+	if (tfa->reset) {
+		usleep_range(5000, 6000);
+		gpiod_set_value_cansleep(tfa->reset, invert_reset ? 1 : 0);
+		usleep_range(5000, 6000);
+	}
+
+	tfa->regmap = devm_regmap_init_i2c(i2c, &tfa9874_regmap);
+	if (IS_ERR(tfa->regmap))
+		return PTR_ERR(tfa->regmap);
+
+	ret = regmap_read(tfa->regmap, TFA_REV, &rev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read REV register\n");
+
+	id = rev & TFA_REV_MASK;
+	if (id == TFA9873_REV_ID) {
+		tfa->is_9873 = true;
+	} else if (id != TFA9874_REV_ID) {
+		return dev_err_probe(dev, -ENODEV, "unexpected rev 0x%04x\n", rev);
+	}
+
+	tfa->rev = rev;
+	ret = tfa9874_init_chip(tfa);
+	if (ret)
+		return dev_err_probe(dev, ret, "chip init failed\n");
+
+	dev_info(dev, "TFA98%x rev 0x%04x ready (slot=%u, gain=%u)\n",
+		 id, tfa->rev, tfa->slot, tfa->gain);
+
+	return devm_snd_soc_register_component(dev, &tfa9874_component,
+					       &tfa9874_dai, 1);
+}
+
+static void tfa9874_remove(struct i2c_client *i2c)
+{
+	struct tfa9874 *tfa = i2c_get_clientdata(i2c);
+
+	tfa9874_stop(tfa);
+}
