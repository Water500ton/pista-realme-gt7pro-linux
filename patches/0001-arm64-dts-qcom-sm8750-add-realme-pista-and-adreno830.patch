+			pins = "gpio18";
+			function = "gpio";
+			bias-pull-down;
+		};
+	};
+
+	wlan_en: wlan-en-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio161";
+		function = "gpio";
+		bias-disable;
+		output-low;
+		drive-strength = <8>;
+	};
+
+	ts_int_active: ts-int-active-state {
+		pins = "gpio162";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <8>;
+		input-enable;
+	};
+
+	ts_reset_suspend: ts-reset-suspend-state {
+		pins = "gpio161";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	ts_int_suspend: ts-int-suspend-state {
+		pins = "gpio162";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	disp0_reset_n_active: disp0-reset-n-active-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
