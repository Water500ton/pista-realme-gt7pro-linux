+/*
+ * Upstream sm8750.dtsi currently defines only hot (120C) and critical (125C)
+ * trips without passive cooling-maps. Add 95C passive throttling for Adreno 830
+ * (gpuss0..7) and Oryon CPU clusters so sustained workloads smoothly throttle
+ * instead of hitting the 125C emergency thermal shutdown.
+ */
+&{/thermal-zones} {
+	gpuss0-thermal {
+		polling-delay-passive = <10>;
+		trips {
+			gpuss0_alert0: gpuss0-alert0 {
+				temperature = <95000>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+		};
+		cooling-maps {
+			map0 {
+				trip = <&gpuss0_alert0>;
+				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+			};
+		};
+	};
