+				   int array_size, u8 settle_cnt)
 {
-	const struct csiphy_lane_regs *r = csiphy->regs->lane_regs;
-	int i, array_size = csiphy->regs->lane_array_size;
+	int i;
 	u32 val;
 
 	for (i = 0; i < array_size; i++, r++) {
@@ -1213,6 +1344,9 @@
 		case CSIPHY_SETTLE_CNT_LOWER_BYTE:
 			val = settle_cnt & 0xff;
 			break;
+		case CSIPHY_SETTLE_CNT_HIGHER_BYTE:
+			val = 0;
+			break;
 		case CSIPHY_SKEW_CAL:
 			/* TODO: support application of skew from dt flag */
 			continue;
@@ -1228,6 +1362,13 @@
 	}
 }
 
+static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
+				     u8 settle_cnt)
+{
+	csiphy_gen2_write_regs(csiphy, csiphy->regs->lane_regs,
+			       csiphy->regs->lane_array_size, settle_cnt);
+}
+
 static u8 csiphy_get_lane_mask(struct csiphy_lanes_cfg *lane_cfg)
 {
 	u8 lane_mask;
@@ -1276,6 +1417,61 @@
 	u8 val;
 	int i;
 
+	if (csiphy->camss->res->version == CAMSS_8750 && cfg->csi2->is_cphy) {
+		/* SM8750 CSIPHY v2.3.0 3-trio C-PHY mode */
+		settle_cnt = csiphy->timer_clk_rate ?
+			     (u8)div_u64(42ULL * csiphy->timer_clk_rate, 400000000ULL) :
+			     0x2a;
+
+		/* reset_enter */
+		writel_relaxed(0x01, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
+		udelay(1);
+
+		/* common_reg_2_3_0 (3PH) */
+		writel_relaxed(0x00, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 33));
+		writel_relaxed(0x0e, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 35));
+		udelay(1);
+
+		writel_relaxed(0x7a, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 7));
+		writel_relaxed(CSIPHY_3PH_CMN_CSI_COMMON_CTRL6_COMMON_PWRDN_B,
+			       csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 6));
+
+		/* lane_en_reg_2_3_0 (trios 0,1,2 -> 0x2a) */
+		val = 0;
+		for (i = 0; i < c->num_data; i++)
+			val |= BIT(c->data[i].pos * 2 + 1);
+		writel_relaxed(val, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
+
+		csiphy_gen2_write_regs(csiphy, lane_regs_sm8750_cphy,
+				       ARRAY_SIZE(lane_regs_sm8750_cphy),
+				       settle_cnt);
+
+		/* reset_exit_reg_2_3_0 (3PH: 0x1000 = 0x0e, delay 3048us) */
+		writel_relaxed(0x0e, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
+		usleep_range(3050, 3500);
+
+		for (i = 11; i < 22; i++) {
+			writel_relaxed(0, csiphy->base +
+				       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
+		}
+		return;
+	}
+
+	if (csiphy->camss->res->version == CAMSS_8750) {
+		writel_relaxed(0x00, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 33));
+		writel_relaxed(0x00, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 35));
+		udelay(1);
+	}
+
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
 
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
@@ -1319,6 +1515,10 @@
 
