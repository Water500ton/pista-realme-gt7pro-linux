+static int imx906_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx906 *sensor = to_imx906(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx906_get_format_code(sensor);
+	return 0;
+}
+
+static int imx906_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx906 *sensor = to_imx906(sd);
+
+	if (fse->index >= ARRAY_SIZE(imx906_modes))
+		return -EINVAL;
+
+	if (fse->code != imx906_get_format_code(sensor))
+		return -EINVAL;
+
+	fse->min_width = imx906_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx906_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static void imx906_update_pad_format(struct imx906 *sensor,
+				      const struct imx906_mode *mode,
+				      struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = imx906_get_format_code(sensor);
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx906_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_format *fmt)
+{
+	struct imx906 *sensor = to_imx906(sd);
+	const struct imx906_mode *mode;
+	int h_blank, ret;
+
+	mode = v4l2_find_nearest_size(imx906_modes, ARRAY_SIZE(imx906_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	imx906_update_pad_format(sensor, mode, fmt);
+	*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	if (media_entity_is_streaming(&sensor->sd.entity))
+		return -EBUSY;
+
+	ret = __v4l2_ctrl_modify_range(sensor->vblank,
+				       mode->fll_min - mode->height,
+				       IMX906_FLL_MAX - mode->height,
+				       1, mode->fll_def - mode->height);
+	if (ret)
+		return ret;
+
+	h_blank = mode->llp - mode->width;
+	return __v4l2_ctrl_modify_range(sensor->hblank, h_blank, h_blank,
+					1, h_blank);
+}
+
+static int imx906_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(sd_state, sel->pad);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = IMX906_NATIVE_WIDTH;
+		sel->r.height = IMX906_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx906_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.code = MEDIA_BUS_FMT_SRGGB10_1X10,
+			.width = imx906_modes[0].width,
+			.height = imx906_modes[0].height,
+		},
+	};
+	struct v4l2_rect *crop;
+
+	crop = v4l2_subdev_state_get_crop(sd_state, 0);
+	crop->top = 0;
+	crop->left = 0;
+	crop->width = IMX906_NATIVE_WIDTH;
+	crop->height = IMX906_NATIVE_HEIGHT;
+
+	return imx906_set_pad_format(sd, sd_state, &fmt);
+}
+
+static int imx906_identify_module(struct imx906 *sensor)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(sensor->regmap, IMX906_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != IMX906_CHIP_ID)
+		return dev_err_probe(sensor->dev, -EIO,
+				     "chip id mismatch: got 0x%04llx\n", val);
+
+	dev_info(sensor->dev, "identified IMX906 (chip id 0x%04llx)\n", val);
+	return 0;
+}
+
+static int imx906_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx906 *sensor = to_imx906(sd);
+
+	clk_disable_unprepare(sensor->img_clk);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(imx906_supply_names),
+			       sensor->supplies);
+
+	return 0;
+}
+
+static int imx906_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx906 *sensor = to_imx906(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx906_supply_names),
+				    sensor->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(sensor->img_clk);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(imx906_supply_names),
+				       sensor->supplies);
+		dev_err(dev, "failed to enable mclk: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(10000, 15000);
+
+	return 0;
+}
+
+static int imx906_enable_stream(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct imx906 *sensor = to_imx906(sd);
+	const struct imx906_mode *mode;
+	struct v4l2_mbus_framefmt *fmt;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(sensor->regmap, imx906_init_regs,
+				  ARRAY_SIZE(imx906_init_regs), NULL);
+	if (ret) {
+		dev_err(sensor->dev, "failed to write init regs: %d\n", ret);
+		goto err_put;
+	}
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	mode = v4l2_find_nearest_size(imx906_modes, ARRAY_SIZE(imx906_modes),
+				      width, height, fmt->width, fmt->height);
+
+	ret = cci_multi_reg_write(sensor->regmap, mode->regs,
+				  mode->num_regs, NULL);
+	if (ret) {
+		dev_err(sensor->dev, "failed to write mode regs: %d\n", ret);
+		goto err_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrl_handler);
+	if (ret)
+		goto err_put;
+
+	ret = cci_write(sensor->regmap, IMX906_REG_MODE_SELECT,
+			IMX906_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_put;
+
+	msleep(12);
+
+	__v4l2_ctrl_grab(sensor->vflip, true);
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	return 0;
+
+err_put:
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static int imx906_disable_stream(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct imx906 *sensor = to_imx906(sd);
+
+	cci_write(sensor->regmap, IMX906_REG_MODE_SELECT,
+		  IMX906_MODE_STANDBY, NULL);
+
+	__v4l2_ctrl_grab(sensor->vflip, false);
+	__v4l2_ctrl_grab(sensor->hflip, false);
+
+	pm_runtime_put(sensor->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops imx906_pad_ops = {
+	.enum_mbus_code = imx906_enum_mbus_code,
+	.enum_frame_size = imx906_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx906_set_pad_format,
+	.get_selection = imx906_get_selection,
+	.enable_streams = imx906_enable_stream,
+	.disable_streams = imx906_disable_stream,
+};
+
+static const struct v4l2_subdev_video_ops imx906_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_ops imx906_subdev_ops = {
+	.video = &imx906_video_ops,
+	.pad = &imx906_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx906_internal_ops = {
+	.init_state = imx906_init_state,
+};
+
+static int imx906_init_controls(struct imx906 *sensor)
+{
+	const struct imx906_mode *mode = &imx906_modes[0];
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrl_handler;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank, vblank, max_exp;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(imx906_link_freq_menu) - 1,
+				      0, imx906_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE,
+			  IMX906_PIXEL_RATE, IMX906_PIXEL_RATE,
+			  1, IMX906_PIXEL_RATE);
+
+	hblank = mode->llp - mode->width;
+	sensor->hblank = v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank,
+					   1, hblank);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->fll_def - mode->height;
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->fll_min - mode->height,
+					   IMX906_FLL_MAX - mode->height,
+					   1, vblank);
+
+	max_exp = mode->fll_def - IMX906_EXPOSURE_MARGIN;
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX906_EXPOSURE_MIN, max_exp,
+					     IMX906_EXPOSURE_STEP,
+					     IMX906_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX906_ANA_GAIN_MIN, IMX906_ANA_GAIN_MAX,
+			  IMX906_ANA_GAIN_STEP, IMX906_ANA_GAIN_DEFAULT);
+
+	sensor->hflip = v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (sensor->hflip)
+		sensor->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	sensor->vflip = v4l2_ctrl_new_std(hdl, &imx906_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (sensor->vflip)
+		sensor->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx906_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx906_test_pattern_menu) - 1,
+				     0, 0, imx906_test_pattern_menu);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx906_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int imx906_parse_endpoint(struct imx906 *sensor)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!ep)
+		return dev_err_probe(sensor->dev, -ENXIO,
+				     "failed to get endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 3) {
+		dev_err(sensor->dev, "only 3-trio C-PHY is supported\n");
+		ret = -EINVAL;
+	}
+
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int imx906_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx906 *sensor;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = dev;
+
+	ret = imx906_parse_endpoint(sensor);
+	if (ret)
+		return ret;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(dev, PTR_ERR(sensor->regmap),
+				     "failed to init CCI regmap\n");
+
+	sensor->img_clk = devm_clk_get(dev, NULL);
+	if (IS_ERR(sensor->img_clk))
+		return dev_err_probe(dev, PTR_ERR(sensor->img_clk),
+				     "failed to get mclk\n");
+
+	if (clk_get_rate(sensor->img_clk) != IMX906_EXT_CLK) {
+		ret = clk_set_rate(sensor->img_clk, IMX906_EXT_CLK);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to set mclk rate\n");
+	}
+
+	for (i = 0; i < ARRAY_SIZE(imx906_supply_names); i++)
+		sensor->supplies[i].supply = imx906_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx906_supply_names),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sensor->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &imx906_subdev_ops);
+	sensor->sd.internal_ops = &imx906_internal_ops;
+
+	ret = imx906_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx906_identify_module(sensor);
+	if (ret)
+		goto err_power_off;
+
+	ret = imx906_init_controls(sensor);
+	if (ret)
+		goto err_power_off;
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_free_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm_disable;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&sensor->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+err_power_off:
+	imx906_power_off(dev);
+	return ret;
+}
+
+static void imx906_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx906 *sensor = to_imx906(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev))
+		imx906_power_off(sensor->dev);
+	pm_runtime_set_suspended(sensor->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx906_pm_ops, imx906_power_off,
+				 imx906_power_on, NULL);
+
+static const struct of_device_id imx906_of_match[] = {
+	{ .compatible = "sony,imx906" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx906_of_match);
+
+static struct i2c_driver imx906_i2c_driver = {
+	.driver = {
+		.name = "imx906",
+		.pm = pm_ptr(&imx906_pm_ops),
+		.of_match_table = imx906_of_match,
+	},
+	.probe = imx906_probe,
+	.remove = imx906_remove,
+};
+module_i2c_driver(imx906_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX906 image sensor driver");
+MODULE_LICENSE("GPL");
