+static u32 imx906_get_format_code(struct imx906 *sensor)
+{
+	static const u32 codes[2][2] = {
+		{ MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10 },
+		{ MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10 },
+	};
+	unsigned int v = sensor->vflip ? sensor->vflip->val : 0;
+	unsigned int h = sensor->hflip ? sensor->hflip->val : 0;
+
+	return codes[v][h];
+}
+
+static int imx906_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx906 *sensor =
+		container_of(ctrl->handler, struct imx906, ctrl_handler);
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_subdev_state *state;
+	u32 fll;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&sensor->sd);
+	fmt = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		u32 max_exp = fmt->height + ctrl->val - IMX906_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(sensor->exposure,
+					 sensor->exposure->minimum,
+					 max_exp, sensor->exposure->step,
+					 min_t(u32, sensor->exposure->val, max_exp));
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sensor->regmap, IMX906_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(sensor->regmap, IMX906_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		fll = fmt->height + ctrl->val;
+		ret = cci_write(sensor->regmap, IMX906_REG_FLL, fll, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(sensor->regmap, IMX906_REG_ORIENTATION,
+				sensor->hflip->val | (sensor->vflip->val << 1),
+				NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(sensor->regmap, IMX906_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx906_ctrl_ops = {
