+static void qcom_battmgr_apply_oem_overrides(struct qcom_battmgr *battmgr)
+{
+	const u32 design_uah_2s = 3250000; /* 2S x 3250 mAh = 6500 mAh equiv (~25.2 Wh) */
+
+	if (!battmgr->oem.valid)
+		return;
+
+	if (battmgr->oem.soh > 0 && battmgr->oem.soh <= 100)
+		battmgr->status.soh_percent = battmgr->oem.soh;
+
+	if (battmgr->oem.cc > 0)
+		battmgr->info.cycle_count = battmgr->oem.cc;
+
+	if (qcom_battmgr_is_pista_2s(battmgr)) {
+		battmgr->info.design_capacity = design_uah_2s;
+		if (battmgr->oem.soh > 0 && battmgr->oem.soh <= 100)
+			battmgr->info.last_full_capacity =
+				DIV_ROUND_CLOSEST_ULL((u64)design_uah_2s * battmgr->oem.soh, 100);
+		else if (battmgr->oem.fcc_mah > 0)
+			battmgr->info.last_full_capacity = battmgr->oem.fcc_mah * 1000;
+	} else if (battmgr->oem.fcc_mah > 0) {
+		battmgr->info.last_full_capacity = battmgr->oem.fcc_mah * 1000;
+		if (battmgr->oem.soh > 0 && battmgr->oem.soh <= 100)
+			battmgr->info.design_capacity =
+				DIV_ROUND_CLOSEST_ULL((u64)battmgr->oem.fcc_mah * 100, battmgr->oem.soh) * 1000;
+	}
+}
