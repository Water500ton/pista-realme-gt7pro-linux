+static int qcom_battmgr_oem_read_buffer(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_oem_read_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_OEM_READ_BUFFER),
+		.data_size = cpu_to_le32(BATTMGR_OEM_BUFFER_WORDS * sizeof(__le32)),
+	};
+	int ret;
+
+	if (battmgr->oem.valid &&
+	    time_before(jiffies, battmgr->oem.last_update + 5 * HZ))
+		return 0;
+
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	if (!ret && battmgr->oem.valid)
+		battmgr->oem.last_update = jiffies;
+
+	return ret;
+}
