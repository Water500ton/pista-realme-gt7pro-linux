+static bool qcom_battmgr_usb_is_pd(unsigned int usb_type)
+{
+	return usb_type == POWER_SUPPLY_USB_TYPE_PD ||
+	       usb_type == POWER_SUPPLY_USB_TYPE_PD_DRP ||
+	       usb_type == POWER_SUPPLY_USB_TYPE_PD_PPS;
+}
+
+static int qcom_battmgr_pista_set_pd_voltage(struct qcom_battmgr *battmgr, u32 mv)
+{
+	int ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OEM_PROPERTY_SET,
+					    OEM_PROP_PD_VOLT_MV, mv);
+	if (!ret)
+		return 0;
+
+	return qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+					     BATT_PD_VOLT_MV, mv);
+}
+
+static void qcom_battmgr_pd_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr =
+		container_of(work, struct qcom_battmgr, pd_work.work);
+	int ret_v, ret_icl;
+	bool is_pd, want_9v;
+
+	if (!battmgr->service_up)
+		return;
+
+	mutex_lock(&battmgr->lock);
+	if (qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0) ||
+	    !battmgr->usb.online) {
+		battmgr->pd_9v_active = false;
+		mutex_unlock(&battmgr->lock);
+		return;
+	}
+
+	qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ADAP_TYPE, 0);
+	qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_NOW, 0);
+	qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_TEMP, 0);
+	qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CAPACITY, 0);
+
+	is_pd = qcom_battmgr_usb_is_pd(battmgr->usb.usb_type);
+	want_9v = is_pd &&
+		  battmgr->status.temperature < 420 &&
+		  battmgr->status.percent < 90;
+
+	if (want_9v && (!battmgr->pd_9v_active || battmgr->usb.voltage_now < 7500000)) {
+		ret_v = qcom_battmgr_pista_set_pd_voltage(battmgr, 9000);
+		ret_icl = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+							USB_INPUT_CURR_LIMIT, 2000000);
+		if (ret_icl)
+			ret_icl = qcom_battmgr_request_property(battmgr, BATTMGR_OEM_PROPERTY_SET,
+								OEM_PROP_USB_ICL, 2000000);
+		dev_info(battmgr->dev,
+			 "pd 18w req (type=%u vbus=%umV temp=%d soc=%u%%): volt=%d icl=%d\n",
+			 battmgr->usb.usb_type, battmgr->usb.voltage_now / 1000,
+			 battmgr->status.temperature, battmgr->status.percent,
+			 ret_v, ret_icl);
+		if (!ret_v)
+			battmgr->pd_9v_active = true;
+	} else if (battmgr->pd_9v_active &&
+		   (!is_pd || battmgr->status.temperature >= 450 || battmgr->status.percent >= 95)) {
+		ret_v = qcom_battmgr_pista_set_pd_voltage(battmgr, 5000);
+		dev_info(battmgr->dev,
+			 "pd drop to 5v (temp=%d soc=%u%%): ret=%d\n",
+			 battmgr->status.temperature, battmgr->status.percent, ret_v);
+		battmgr->pd_9v_active = false;
+	}
+
+	if (battmgr->pd_9v_active)
+		mod_delayed_work(system_dfl_wq, &battmgr->pd_work, msecs_to_jiffies(30000));
+	mutex_unlock(&battmgr->lock);
+
+	power_supply_changed(battmgr->usb_psy);
+	power_supply_changed(battmgr->bat_psy);
+}
+
+static void qcom_battmgr_otg_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, otg_work);
+	bool want_boost = atomic_read(&battmgr->otg_bus_cnt) > 0;
+	int ret;
+
+	if (!battmgr->service_up || want_boost == battmgr->otg_boost_active)
+		return;
+
+	mutex_lock(&battmgr->lock);
+	if (want_boost) {
+		qcom_battmgr_request_property(battmgr, BATTMGR_OEM_PROPERTY_SET,
+					      OEM_PROP_OTG_BOOST_CURR_LIMIT, 1500);
+	}
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OEM_PROPERTY_SET,
+					    OEM_PROP_OTG_BOOST, want_boost ? 1 : 0);
+	if (ret)
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    USB_PROP_OTG_BOOST, want_boost ? 1 : 0);
+	if (!ret)
+		battmgr->otg_boost_active = want_boost;
