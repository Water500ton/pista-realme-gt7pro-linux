	cpu-0-4-0-thermal {
		polling-delay-passive = <100>;
		trips {
			cpu0_4_alert0: cpu-0-4-0-alert0 {
				temperature = <95000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
		cooling-maps {
			map0 {
				trip = <&cpu0_4_alert0>;
				cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	cpu-0-5-0-thermal {
		polling-delay-passive = <100>;
		trips {
			cpu0_5_alert0: cpu-0-5-0-alert0 {
				temperature = <95000>;
