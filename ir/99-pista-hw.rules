# Allow video group or active local console users (uaccess) to control rear flashlight LED and IR blaster without sudo
SUBSYSTEM=="leds", KERNEL=="white:flash*", GROUP="video", TAG+="uaccess", RUN+="/bin/chgrp video /sys/class/leds/%k/brightness", RUN+="/bin/chmod 0666 /sys/class/leds/%k/brightness"
SUBSYSTEM=="lirc", KERNEL=="lirc*", GROUP="video", MODE="0660", TAG+="uaccess"
